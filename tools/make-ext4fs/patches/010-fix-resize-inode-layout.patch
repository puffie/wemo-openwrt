From: Harry Kim <harry.kim@newracom.com>
Subject: [PATCH] make_ext4fs: fix resize inode reserved GDT layout

The double-indirect entries for the resize inode are indexed by the
current number of group descriptor blocks.  Rotating them within the
number of reserved entries instead leaves the final primary reserved GDT
block unreachable.  For a 256 MiB filesystem with 4 KiB blocks this
duplicates block 2 at slot 0 and omits block 16 from slot 15, causing an
online resize to fail when the first backup GDT is added.

Place every primary reserved GDT block at the offset expected by ext4,
keep its backup pointers in the matching indirect block, and use the
maximum double-indirect file size for the resize inode as e2fsprogs does.

Signed-off-by: Harry Kim <harry.kim@newracom.com>

--- a/indirect.c
+++ b/indirect.c
@@ -432,7 +432,8 @@ void inode_attach_resize(struct ext4_inode *inode,
 	u32 superblocks = block_len / info.bg_desc_reserve_blocks;
 	u32 i, j;
+	u32 dind_index;
 	u64 blocks;
 	u64 size;
 
 	if (block_len % info.bg_desc_reserve_blocks)
 		critical_error("reserved blocks not a multiple of %d",
@@ -455,24 +456,19 @@ void inode_attach_resize(struct ext4_inode *inode,
 			get_block(alloc, 0));
 
 	for (i = 0; i < info.bg_desc_reserve_blocks; i++) {
-		int r = (i - aux_info.bg_desc_blocks) % info.bg_desc_reserve_blocks;
-		if (r < 0)
-			r += info.bg_desc_reserve_blocks;
-
-		dind_block_data[i] = get_block(alloc, r);
+		dind_index = (i + aux_info.bg_desc_blocks) %
+			aux_info.blocks_per_ind;
+		dind_block_data[dind_index] = get_block(alloc, i);
 
 		for (j = 1; j < superblocks; j++) {
-			u32 b = j * info.bg_desc_reserve_blocks + r;
-			ind_block_data[r * aux_info.blocks_per_ind + j - 1] = get_block(alloc, b);
+			u32 b = j * info.bg_desc_reserve_blocks + i;
+			ind_block_data[i * aux_info.blocks_per_ind + j - 1] = get_block(alloc, b);
 		}
 	}
 
-	u32 last_block = EXT4_NDIR_BLOCKS + aux_info.blocks_per_ind +
-			aux_info.blocks_per_ind * (info.bg_desc_reserve_blocks - 1) +
-			superblocks - 2;
-
 	blocks = ((u64)block_len + 1) * info.block_size / 512;
-	size = (u64)last_block * info.block_size;
+	size = ((u64)aux_info.blocks_per_ind * aux_info.blocks_per_ind +
+		aux_info.blocks_per_ind + EXT4_NDIR_BLOCKS) * info.block_size;
 
 	inode->i_block[EXT4_DIND_BLOCK] = dind_block;
 	inode->i_flags = 0;
