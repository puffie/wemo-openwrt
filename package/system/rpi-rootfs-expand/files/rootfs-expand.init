#!/bin/sh /etc/rc.common

START=98

STATE_FILE=/etc/rootfs-expand.state
TAG=rootfs-expand

root_block_info() {
	local root_majmin root_path

	root_majmin="$(awk '$5 == "/" { print $3; exit }' /proc/self/mountinfo)"
	[ -n "$root_majmin" ] || return 1

	root_path="$(readlink -f "/sys/dev/block/$root_majmin")"
	[ -n "$root_path" ] || return 1

	ROOT_NAME="${root_path##*/}"
	ROOT_DEV="/dev/$ROOT_NAME"
	DISK_NAME="${root_path%/*}"
	DISK_NAME="${DISK_NAME##*/}"
	DISK_DEV="/dev/$DISK_NAME"
	PART_NUM="$(cat "/sys/class/block/$ROOT_NAME/partition" 2>/dev/null)"

	[ -b "$ROOT_DEV" ] && [ -b "$DISK_DEV" ] && [ -n "$PART_NUM" ]
}

filesystem_is_ext4() {
	[ "$(awk '$2 == "/" { print $3; exit }' /proc/mounts)" = "ext4" ]
}

partition_has_free_tail() {
	local free_sectors value

	DISK_SECTORS="$(cat "/sys/class/block/$DISK_NAME/size" 2>/dev/null)"
	PART_START="$(cat "/sys/class/block/$ROOT_NAME/start" 2>/dev/null)"
	PART_SECTORS="$(cat "/sys/class/block/$ROOT_NAME/size" 2>/dev/null)"

	for value in "$DISK_SECTORS" "$PART_START" "$PART_SECTORS"; do
		case "$value" in
			''|*[!0-9]*) return 2 ;;
		esac
	done

	[ "$DISK_SECTORS" -ge $((PART_START + PART_SECTORS)) ] || return 2
	free_sectors=$((DISK_SECTORS - PART_START - PART_SECTORS))

	# Ignore the final alignment gap when the partition already fills the disk.
	[ "$free_sectors" -gt 2048 ]
}

filesystem_fills_partition() {
	local filesystem_geometry filesystem_kib partition_kib missing_kib value

	filesystem_geometry="$(tune2fs -l "$ROOT_DEV" 2>/dev/null | awk -F: '
		/^Block count:/ { gsub(/[[:space:]]/, "", $2); blocks = $2 }
		/^Block size:/  { gsub(/[[:space:]]/, "", $2); size = $2 }
		END { if (blocks && size) print blocks, size }
	')"
	set -- $filesystem_geometry
	[ "$#" -eq 2 ] || return 1
	for value in "$1" "$2"; do
		case "$value" in
			''|*[!0-9]*) return 1 ;;
		esac
	done

	filesystem_kib=$(($1 * $2 / 1024))
	partition_kib=$((PART_SECTORS / 2))
	missing_kib=$((partition_kib - filesystem_kib))

	# Allow for filesystem and partition boundary rounding.
	[ "$missing_kib" -ge 0 ] && [ "$missing_kib" -le 1024 ]
}

write_state() {
	[ "$(cat "$STATE_FILE" 2>/dev/null)" = "$1" ] ||
		printf '%s\n' "$1" > "$STATE_FILE"
}

finish_filesystem_resize() {
	logger -t "$TAG" "expanding ext4 filesystem on $ROOT_DEV"
	if ! resize2fs -f "$ROOT_DEV"; then
		logger -t "$TAG" "resize2fs failed for $ROOT_DEV; retrying next boot"
		return 1
	fi

	write_state complete
	logger -t "$TAG" "root filesystem expansion complete"
}

boot() {
	if ! filesystem_is_ext4; then
		if [ "$(cat "$STATE_FILE" 2>/dev/null)" != "unsupported" ]; then
			logger -t "$TAG" "root filesystem is not ext4; automatic expansion skipped"
		fi
		write_state unsupported
		return 0
	fi

	if ! root_block_info; then
		logger -t "$TAG" "unable to identify the root block device; retrying next boot"
		return 1
	fi

	partition_has_free_tail
	case "$?" in
		0) ;;
		1)
			if filesystem_fills_partition; then
				write_state complete
				return 0
			fi
			finish_filesystem_resize
			return $?
			;;
		*)
			logger -t "$TAG" "unable to read the root partition size; retrying next boot"
			return 1
			;;
	esac

	logger -t "$TAG" "expanding partition $PART_NUM on $DISK_DEV"
	# Parted 3.4 needs an explicit answer when the mounted root partition is busy.
	if ! printf '%s\n' yes | parted ---pretend-input-tty \
		"$DISK_DEV" resizepart "$PART_NUM" 100%; then
		logger -t "$TAG" "partition expansion failed; retrying next boot"
		return 1
	fi

	write_state partition
	sync
	logger -t "$TAG" "partition expanded; rebooting once before resize2fs"
	(sleep 3; reboot) &
}
